{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Nén theo danh sách loại nội dung rõ ràng, KHÔNG gồm text/event-stream: mặc định của encode
	# khớp text/* nên luồng chat SSE bị nén và token có thể bị dồn lại thay vì hiện dần
	# (nginx tắt gzip cho SSE theo cùng lý do).
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	# Bảo mật cơ bản cho toàn site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self)"
		-Server
	}

	# Chống clickjacking cho toàn site, TRỪ trang widget /embed: widget.js nhúng trang này
	# bằng iframe trên website khách hàng, nên SAMEORIGIN ở đây làm widget trắng trơn.
	@not_embed not path /embed /embed/*
	# ">" = đặt SAU khi có phản hồi, THAY header cùng tên của upstream. Không có ">" thì Caddy đặt
	# trước rồi API (middleware header bảo mật) thêm "DENY" phía sau: hai giá trị mâu thuẫn
	# "SAMEORIGIN, DENY" (dry run 2026-11-17), trình duyệt coi là không hợp lệ.
	header @not_embed >X-Frame-Options "SAMEORIGIN"
	@embed path /embed /embed/*
	header @embed Content-Security-Policy "frame-ancestors *"

	# API: bỏ tiền tố /api. SSE (chat stream) cần flush ngay, không đệm.
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	# Giới hạn upload tài liệu (đồng bộ với giới hạn ở backend)
	request_body {
		max_size 30MB
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Các dự án khác trên cùng VM (Telecom, EduDSS...) — mỗi dự án một file .caddy.
import /etc/caddy/sites/*.caddy
