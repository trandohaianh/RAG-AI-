{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Bảo mật cơ bản cho toàn site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self)"
		-Server
	}

	# Chống clickjacking cho toàn site, TRỪ trang widget /embed: widget.js nhúng trang này
	# bằng iframe trên website khách hàng, nên SAMEORIGIN ở đây làm widget trắng trơn.
	@not_embed not path /embed /embed/*
	header @not_embed X-Frame-Options "SAMEORIGIN"
	@embed path /embed /embed/*
	header @embed Content-Security-Policy "frame-ancestors *"

	# API: bỏ tiền tố /api. SSE (chat stream) cần flush ngay, không đệm.
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	# Giới hạn upload tài liệu (đồng bộ với giới hạn ở backend)
	request_body {
		max_size 30MB
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

# Các dự án khác trên cùng VM (Telecom, EduDSS...) — mỗi dự án một file .caddy.
import /etc/caddy/sites/*.caddy
