# Sao chép thành .env (chmod 600). setup-vm.sh tự tạo SECRET_KEY và METRICS_TOKEN.

# --- Bắt buộc ---
# tên miền trỏ về IP public của VM
APP_DOMAIN=fieldops-demo.duckdns.org
# email nhận thông báo chứng chỉ Let's Encrypt
ACME_EMAIL=ban@example.com
# ≥32 ký tự ngẫu nhiên (ký JWT)
SECRET_KEY=
# Bearer token để Grafana Cloud đọc /api/metrics
METRICS_TOKEN=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Đăng nhập Google (khuyến nghị) ---
# xxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Email: xác thực tài khoản + quên mật khẩu (Resend free) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# bật true sau khi đã gửi được email
REQUIRE_EMAIL_VERIFICATION=false

# --- Chi phí ---
# free | paid (chỉ ảnh hưởng nhãn hiển thị)
LLM_BILLING_TIER=free
# 0 = không giới hạn; VD 2 = chặn khi cả hệ thống dùng hết $2/ngày
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
# LLM_PRICING_JSON={"gemini-3-flash": {"input": 0.5, "output": 3.0}}

# --- Tuỳ chọn ---
# nếu dùng DuckDNS: setup-vm.sh cài cron cập nhật IP
DUCKDNS_TOKEN=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
COHERE_API_KEY=
JUDGE_SAMPLE_RATE=0.1
FREE_PLAN_DAILY_QUERIES=50
# trống = SQLite trên volume; hoặc chuỗi Postgres của Neon
DATABASE_URL=
BACKUP_KEEP=7
# giờ UTC chạy pipeline hằng ngày
PIPELINE_DAILY_AT=02:00
# VD ,https://site-khac.com (bắt đầu bằng dấu phẩy) cho widget nhúng
EXTRA_CORS_ORIGINS=
