# Sao chép thành .env (chmod 600). setup-vm.sh tự tạo SECRET_KEY và METRICS_TOKEN.

# --- Bắt buộc ---
# tên miền trỏ về IP public của VM
APP_DOMAIN=fieldops-demo.duckdns.org
# email nhận thông báo chứng chỉ Let's Encrypt
ACME_EMAIL=ban@example.com
# ≥32 ký tự ngẫu nhiên (ký JWT)
SECRET_KEY=
# Bearer token để Grafana Cloud đọc /api/metrics
METRICS_TOKEN=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Đăng nhập Google (khuyến nghị) ---
# xxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Địa chỉ → toạ độ (M13, OpenStreetMap/Nominatim, miễn phí) ---
# Nominatim bắt buộc ghi liên hệ trong User-Agent: email hoặc trang liên hệ của bạn.
# Để trống = tắt nút "Tìm toạ độ"; toạ độ vẫn nhập tay / GPS được.
NOMINATIM_CONTACT=

# --- Thông báo đẩy cho thợ (M15, Expo Push, miễn phí, chỉ Android) ---
# Mặc định bật; máy chủ chỉ gửi khi app Android (bản build có projectId của Expo) đã đăng ký.
PUSH_ENABLED=1
# Chỉ cần khi bật "Enhanced security for push notifications" trên expo.dev (khuyến nghị).
EXPO_ACCESS_TOKEN=

# --- Chính sách quyền riêng tư (bước 7) ---
# Liên hệ hiện trên trang /privacy để người dùng hỏi hoặc khiếu nại về dữ liệu cá nhân
# (email hoặc trang liên hệ). Đổi xong cần build lại web: docker compose build web.
# App điện thoại dùng EXPO_PUBLIC_PRIVACY_CONTACT khi build APK.
PRIVACY_CONTACT=

# --- Email: xác thực tài khoản + quên mật khẩu ---
# Cách 1 (không cần domain riêng): Gmail SMTP + App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Cách 2: Resend (cần domain đã xác minh để gửi cho người khác)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# bật true sau khi đã gửi được email
REQUIRE_EMAIL_VERIFICATION=false

# --- Chi phí ---
# free | paid (chỉ ảnh hưởng nhãn hiển thị)
LLM_BILLING_TIER=free
# 0 = không giới hạn; VD 2 = chặn khi cả hệ thống dùng hết $2/ngày
LLM_DAILY_BUDGET_USD=2
LLM_USER_DAILY_BUDGET_USD=0.2
# LLM_PRICING_JSON={"gemini-3-flash": {"input": 0.5, "output": 3.0}}

# --- Tuỳ chọn ---
# nếu dùng DuckDNS: setup-vm.sh cài cron cập nhật IP
DUCKDNS_TOKEN=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
COHERE_API_KEY=
JUDGE_SAMPLE_RATE=0.1
FREE_PLAN_DAILY_QUERIES=50
# trống = SQLite trên volume; hoặc chuỗi Postgres của Neon
DATABASE_URL=
BACKUP_KEEP=7
# giờ UTC chạy pipeline hằng ngày
PIPELINE_DAILY_AT=02:00
# VD ,https://site-khac.com (bắt đầu bằng dấu phẩy) cho widget nhúng
EXTRA_CORS_ORIGINS=
