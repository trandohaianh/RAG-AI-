APP_ENV=development
GEMINI_API_KEY=your_gemini_key_here
SECRET_KEY=your_jwt_secret_32chars_minimum
ALGORITHM=HS256

# Production/staging: set the exact web origin(s), separated by commas.
# CORS_ORIGINS=https://field.example.com,https://admin.example.com
# Optional explicit origin regex. LAN defaults apply only in development/local/test.
# CORS_ORIGIN_REGEX=

# Medallion warehouse (PostgreSQL)
POSTGRES_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag_dw
MEDALLION_ENABLED=true

# Optional tuning
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash
# Ti le cau tra loi duoc cham diem tu dong (0-1)
JUDGE_SAMPLE_RATE=0.1
# Sinh van ban bang Ollama local (khong can key): LLM_PROVIDER=ollama
# OCR anh va embedding van dung Gemini
LLM_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Timeout I/O cho Gemini/Ollama (giay); khong phai deadline tong cua stream
LLM_REQUEST_TIMEOUT_SEC=60
CHUNK_SIZE=1000
EMBED_BATCH_SIZE=20
EMBED_BATCH_DELAY_SEC=1.5

# Tuần 1–2: Redis cache retrieve + Cohere rerank (tùy chọn)
REDIS_URL=

# M13: tra địa chỉ → toạ độ qua OpenStreetMap (Nominatim). Bắt buộc liên hệ (email/trang web);
# để trống = tắt tra cứu, chỉ nhập toạ độ tay.
NOMINATIM_CONTACT=

# M15: thông báo đẩy qua Expo Push. PUSH_ENABLED=0 để tắt; EXPO_ACCESS_TOKEN không bắt buộc.
PUSH_ENABLED=1
EXPO_ACCESS_TOKEN=
REDIS_CACHE_TTL_SEC=300
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
RETRIEVE_CANDIDATES=15

# Grafana (chi khi chay docker compose grafana) — KHONG phai tai khoan RAG
# URL: http://localhost:3002   user: admin   password: admin

# Tuần 5–8: SaaS
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
FREE_PLAN_DAILY_QUERIES=50
PRO_PLAN_DAILY_QUERIES=1000

# Stripe (tuần 7–8, tùy chọn)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# --- Full-stack (11/2026) ---
# Google Sign-In (OAuth client "Web application"); để trống = ẩn nút Google
GOOGLE_CLIENT_ID=
# Đăng ký: invite = chỉ bằng mã mời admin tạo (mặc định khi APP_ENV=production); open = tự do (mặc định dev)
# SIGNUP_MODE=open
# Bắt buộc xác thực email (chỉ hiệu lực khi có RESEND_API_KEY)
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
# Hoặc Gmail SMTP + App Password (không cần domain riêng)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Bearer token bảo vệ /metrics khi APP_ENV=production (Grafana Cloud dùng token này)
METRICS_TOKEN=
# Theo dõi chi phí: free|paid; ngân sách ngày (0 = không giới hạn)
LLM_BILLING_TIER=free
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
